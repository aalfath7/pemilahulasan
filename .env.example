# Wajib: API key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini yang dipakai. Cek daftar model terbaru di https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Lokal pakai SQLite. Produksi: connection string Neon (postgresql://...), otomatis diubah ke asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./data.db

# Kunci untuk menandatangani cookie login. Wajib di produksi; buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Batas penggunaan
DEMO_MAX_REVIEWS=200
MEMBER_MAX_REVIEWS=2000
MAX_UPLOAD_MB=10
RATE_LIMIT=30/minute
